POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bizcompass
# DATABASE_URL=postgresql://postgres:change-me@localhost:5433/bizcompass

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-key
# For OpenAI, change LLM_PROVIDER=openai and set both values below.
# OPENAI_API_KEY=your-key
# LLM_MODEL=gpt-5-mini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1024

# When LLM_PROVIDER=openai, use an OpenAI embedding model instead.
# EMBEDDING_MODEL=text-embedding-3-small
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_K=5
RETRIEVAL_CANDIDATE_K=20
RRF_K=60
METRICS_PORT=8000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
